  m_Script: {fileID: 11500000, guid: a525c52fa091401b3794d22a7f8dbbfd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tag.Art.Library.LibraryPropMeta
  category: "Buildings"
  summary: "Diner, 10.0 x 7.0 m, walls 4.6 m under a parapet. Cream body, a long mullioned DINER front with a red rail, recessed door, sign band, brick string course, and a sloped red awning. Alley face is -Z."
  climbable: 1
  vaultable: 0
  vaultHeightMeters: 0
  climbNote: "The four walls are cling. Glass is solid. The roof is a parapet, not a rail."
  vaultNote: "No ground-height rail. The parapet is on the roof."
