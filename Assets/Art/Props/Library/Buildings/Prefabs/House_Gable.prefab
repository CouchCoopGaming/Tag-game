  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tag.Art.Library.LibraryPropMeta
  category: "Buildings"
  summary: "Gable house. Body 7.6 x 6.8 m, walls 2.8 m, ridge about 4.6 m. Porch, steps, paneled door, trimmed windows, eave gutters, and a chimney. Porch faces +Z."
  climbable: 1
  vaultable: 1
  vaultHeightMeters: 0.95
  climbNote: "Siding walls are cling. Windows are glass. The porch is open on +Z."
  vaultNote: "Porch rail is 0.95 m above the porch deck."
