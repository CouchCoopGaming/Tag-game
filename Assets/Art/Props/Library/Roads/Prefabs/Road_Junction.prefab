  m_Script: {fileID: 11500000, guid: a525c52fa091401b3794d22a7f8dbbfd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tag.Art.Library.LibraryPropMeta
  category: "Roads"
  summary: "Flush asphalt intersection. Each corner is one sidewalk with a 5 m curb return into straight walks along both arms, and a curb ramp at each crosswalk. The box is clear. A white stop bar covers the inbound lanes only; the double yellow ends at that bar. Butt Road_Straight to the arm ends so the double yellow continues."
  climbable: 0
  vaultable: 0
  vaultHeightMeters: 0
  climbNote: "Flat asphalt and sidewalk. The curb face is 0.15 m above the road."
  vaultNote: "Curb is 0.15 m. Not a vault."
