  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tag.Art.Library.LibraryPropMeta
  category: "Park"
  summary: "Street full court, 22 m by 12 m. One decal carries the FIBA paint scaled to the slab: boundary, center line, center circle, and at each end a lane, free-throw circle, restricted arc, and a 3-point arc that meets the corner lines. Lines are 5 cm. No collider on the paint."
  climbable: 0
  vaultable: 0
  vaultHeightMeters: 0
  climbNote: "Flat slab, 0.12 m thick."
  vaultNote: "No rail. Place each Hoop at the baseline with the rim facing center court."
